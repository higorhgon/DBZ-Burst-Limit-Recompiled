# Build output
/out/
/build/

# Android (Gradle / Android Studio)
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
*.keystore
*.jks

# Recompiled code is generated from the game executable during the build.
/generated/default/

# Game files (never commit copyrighted game data)
/game_data_root/
*.xex
*.CPK
*.cpk

# Texture dumps / replacement packs
/textures/

# The extra stages' thumbnails (made from screenshots of the game): only in the
# release builds.
/src/burstlimit_stage_thumbs.inc

# Local runtime files
*.log
/burstlimit.toml
/isenseconfig/

# Third-party SDKs that cannot be redistributed
/third_party/discord_social_sdk/

# IDE
/.vs/
/.vscode/

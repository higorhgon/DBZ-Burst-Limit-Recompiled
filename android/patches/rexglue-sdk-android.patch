+namespace {
+// Android gives the game process no debugger. An infinite wait runs in 5 s
+// slices (the same wait), and the first slice that times out logs who waits
+// on what and from where, so a deadlock can be read from the log.
+constexpr auto kWaitWatchSlice = std::chrono::milliseconds(5000);
+
+void LogLongWait(const char* kind, XObject* object, XObject* signaled = nullptr) {
+  XThread* thread = XThread::IsInThread() ? XThread::GetCurrentThread() : nullptr;
+  uint32_t lr = 0;
+  if (thread && thread->thread_state() && thread->thread_state()->context()) {
+    lr = static_cast<uint32_t>(thread->thread_state()->context()->lr);
+  }
+  std::string signal_text;
+  if (signaled) {
+    signal_text = fmt::format(" after signaling handle {:08X} type {}", signaled->handle(),
+                              static_cast<uint32_t>(signaled->type()));
+  }
+  REXSYS_WARN("[WaitWatch] '{}' (thread_id {:X}, guest lr {:08X}) {} > 5 s on handle {:08X} "
+              "type {} guest {:08X} '{}'{}",
+              thread ? thread->name() : std::string("?"), thread ? thread->thread_id() : 0, lr,
+              kind, object->handle(), static_cast<uint32_t>(object->type()),
+              object->guest_object(), object->name(), signal_text);
+  // What this thread asked the kernel for before it got stuck, oldest first.
+  const auto& trail = rex::kernel::trail::import_trail;
+  uint32_t total = trail.count;
+  uint32_t shown = std::min(total, rex::kernel::trail::kTrailSize);
+  std::string text;
+  for (uint32_t i = total - shown; i < total; ++i) {
+    const auto& call = trail.calls[i % rex::kernel::trail::kTrailSize];
+    std::string_view name = call.name;
+    if (name.starts_with("__imp__")) {
+      name.remove_prefix(7);
+    }
+    text += fmt::format("\n    #{} {} (lr {:08X}) {:08X} {:08X} {:08X} {:08X}", i, name, call.lr,
+                        call.args[0], call.args[1], call.args[2], call.args[3]);
+    text += call.returned ? fmt::format(" -> {:08X}", call.result) : std::string(" (in call)");
+  }
+  REXSYS_WARN("[WaitWatch] last {} of {} kernel calls of this thread:{}", shown, total, text);
+}
+}  // namespace
+#endif

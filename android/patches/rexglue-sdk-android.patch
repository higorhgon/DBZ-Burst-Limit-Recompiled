+std::unordered_map<const XObject*, uint32_t> watched_objects;
+std::atomic<uint32_t> watched_count{0};
+
+void LogLongWait(const char* kind, XObject* object, XObject* signaled = nullptr) {
+  std::string signal_text;
+  if (signaled) {
+    signal_text = fmt::format(" after signaling handle {:08X} type {}", signaled->handle(),
+                              static_cast<uint32_t>(signaled->type()));
+  }

+    set(SDL_HAPTIC      ON  CACHE BOOL "" FORCE)
+    set(SDL_SENSOR      ON  CACHE BOOL "" FORCE)
+    set(SDL_FILESYSTEM  ON  CACHE BOOL "" FORCE)
+    # A native build in Termux can find its X11 / PulseAudio packages: the
+    # app only uses Android's own drivers.
+    foreach(_sdl_desktop_option X11 WAYLAND ALSA PULSEAUDIO PIPEWIRE JACK SNDIO KMSDRM OFFSCREEN
+                                HIDAPI_LIBUSB LIBUDEV)
+        set(SDL_${_sdl_desktop_option} OFF CACHE BOOL "" FORCE)
+    endforeach()
+    # SDL's own iconv: bionic only has one from API 28, so below that (Termux
+    # builds for 24) SDL would take Termux's libiconv.so, which Android lacks.
+    set(SDL_SYSTEM_ICONV OFF CACHE BOOL "" FORCE)
+elseif(UNIX AND NOT APPLE)
     set(SDL_X11               ON  CACHE BOOL "" FORCE)
     set(SDL_WAYLAND           ON  CACHE BOOL "" FORCE)
     set(SDL_ALSA              ON  CACHE BOOL "" FORCE)

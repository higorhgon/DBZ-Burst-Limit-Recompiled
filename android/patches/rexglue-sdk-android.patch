diff --git a/src/core/fiber_posix.cpp b/src/core/fiber_posix.cpp
index 4fe1ca6..03fd421 100644
--- a/src/core/fiber_posix.cpp
+++ b/src/core/fiber_posix.cpp
@@ -17,7 +17,119 @@
 #endif
 
 #include <rex/platform.h>
-#if REX_PLATFORM_LINUX || REX_PLATFORM_MAC
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+
+#if !defined(__aarch64__)
+#error Android fibers are implemented for AArch64 only.
+#endif
+
+// Saves the callee-saved registers (x19-x30, d8-d15) on the current stack,
+// stores the stack pointer to *save_sp, then loads load_sp and restores the
+// registers saved there. A new fiber's stack holds a frame whose x30 is the
+// trampoline, so the final ret enters it.
+extern "C" void rex_fiber_switch_aarch64(void** save_sp, void* load_sp);
+asm(R"(
+  .text
+  .p2align 4
+  .globl rex_fiber_switch_aarch64
+  .hidden rex_fiber_switch_aarch64
+  .type rex_fiber_switch_aarch64, %function
+rex_fiber_switch_aarch64:
+  sub sp, sp, #176
+  stp x19, x20, [sp, #0]
+  stp x21, x22, [sp, #16]
+  stp x23, x24, [sp, #32]
+  stp x25, x26, [sp, #48]
+  stp x27, x28, [sp, #64]
+  stp x29, x30, [sp, #80]
+  stp d8, d9, [sp, #96]
+  stp d10, d11, [sp, #112]
+  stp d12, d13, [sp, #128]
+  stp d14, d15, [sp, #144]
+  mov x9, sp
+  str x9, [x0]
+  mov sp, x1
+  ldp x19, x20, [sp, #0]
+  ldp x21, x22, [sp, #16]
+  ldp x23, x24, [sp, #32]
+  ldp x25, x26, [sp, #48]
+  ldp x27, x28, [sp, #64]
+  ldp x29, x30, [sp, #80]
+  ldp d8, d9, [sp, #96]
+  ldp d10, d11, [sp, #112]
+  ldp d12, d13, [sp, #128]
+  ldp d14, d15, [sp, #144]
+  add sp, sp, #176
+  ret
+  .size rex_fiber_switch_aarch64, .-rex_fiber_switch_aarch64
+)");
+
+namespace rex::thread {
+
+namespace {
+constexpr size_t kSwitchFrameSize = 176;
+constexpr size_t kSwitchFrameLrOffset = 88;
+}  // namespace
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  // The initial switch frame sits at the 16-byte aligned top of the stack:
+  // all registers zero, x30 = Trampoline.
+  uintptr_t top = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size());
+  top &= ~uintptr_t(15);
+  uint8_t* frame = reinterpret_cast<uint8_t*>(top - kSwitchFrameSize);
+  std::memset(frame, 0, kSwitchFrameSize);
+  void (*trampoline)() = &Fiber::Trampoline;
+  std::memcpy(frame + kSwitchFrameLrOffset, &trampoline, sizeof(trampoline));
+  f->saved_sp_ = frame;
+  return f;
+}
+
+/*static*/ void Fiber::Trampoline() {
+  // tls_current_ was updated by SwitchTo before the switch landed here.
+  Fiber* f = tls_current_;
+  f->entry_(f->arg_);
+  // A fiber's entry never returns (it switches away for good).
+  std::abort();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  tls_current_ = target;
+  rex_fiber_switch_aarch64(&from->saved_sp_, target->saved_sp_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
 
 #include <rex/thread/fiber.h>
 

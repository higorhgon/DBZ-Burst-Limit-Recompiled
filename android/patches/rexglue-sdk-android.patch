diff --git a/include/rex/kernel/import_trail.h b/include/rex/kernel/import_trail.h
new file mode 100644
index 0000000..18bf2b4
--- /dev/null
+++ b/include/rex/kernel/import_trail.h
@@ -0,0 +1,80 @@
+/**
+ * @file        import_trail.h
+ * @brief       Android: the last kernel imports each thread called
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+#include <rex/hook.h>
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+namespace rex::kernel::trail {
+
+// Android gives the game process no debugger. Each thread keeps the last
+// kernel imports it called (name, guest return address, arguments, result),
+// printed when it waits too long (see XObject::Wait), to find what a stuck
+// thread was doing.
+struct ImportCall {
+  const char* name;
+  uint32_t lr;
+  uint32_t args[4];
+  uint32_t result;
+  bool returned;
+};
+
+constexpr uint32_t kTrailSize = 48;
+
+struct ImportTrail {
+  ImportCall calls[kTrailSize];
+  uint32_t count = 0;
+};
+
+inline thread_local ImportTrail import_trail;
+
+// Called so often they would push everything else out.
+constexpr bool IsHotImport(std::string_view name) {
+  return name == "__imp__KeTlsGetValue" || name == "__imp__KeTlsSetValue" ||
+         name == "__imp__KeQueryPerformanceCounter" || name == "__imp__KeQuerySystemTime" ||
+         name == "__imp__KeGetCurrentProcessType";
+}
+
+inline ImportCall* Record(const char* name, const PPCContext& ctx) {
+  ImportTrail& trail = import_trail;
+  ImportCall& call = trail.calls[trail.count++ % kTrailSize];
+  call.name = name;
+  call.lr = static_cast<uint32_t>(ctx.lr);
+  call.args[0] = ctx.r3.u32;
+  call.args[1] = ctx.r4.u32;
+  call.args[2] = ctx.r5.u32;
+  call.args[3] = ctx.r6.u32;
+  call.result = 0;
+  call.returned = false;
+  return &call;
+}
+
+}  // namespace rex::kernel::trail
+
+#ifndef REXGLUE_ENABLE_PROFILING
+#undef REX_HOOK
+#define REX_HOOK(subroutine, function)                                             \
+  extern "C" REX_FUNC(subroutine) {                                                \
+    if constexpr (!::rex::kernel::trail::IsHotImport(#subroutine)) {                 \
+      auto* trail_call = ::rex::kernel::trail::Record(#subroutine, ctx);             \
+      ::rex::ppc::HostToGuestFunction<function>(ctx, base);                          \
+      trail_call->result = ctx.r3.u32;                                             \
+      trail_call->returned = true;                                                 \
+    } else {                                                                       \
+      ::rex::ppc::HostToGuestFunction<function>(ctx, base);                          \
+    }                                                                              \
+  }
+#endif
+
+#endif  // REX_PLATFORM_ANDROID
